+# Closure metrics
+Record outcomes, debt, calibration, behavior flags, stranger review, stop conditions and attestation inputs. Preserve partial or halted status.
diff --git a/modules/closure-metrics/module.yaml b/modules/closure-metrics/module.yaml
new file mode 100644
index 0000000..b564e59
--- /dev/null
+++ b/modules/closure-metrics/module.yaml
@@ -0,0 +1,68 @@
+schema_version: 1.0.0
+id: MOD-CLOSURE-METRICS
+version: 0.1.0
+status: experimental
+kind: meta
+title: Closure metrics and attestation
+summary: Records metrics, debt, calibration, behavior signals, stranger review, stop conditions, and attestation
+  after adversarial and fidelity checks.
+gate_coverage:
+- HG-M
+phase_coverage:
+- M
+selection:
+  policy: any_active_gate
+  priority: 950
+  dependencies:
+  - MOD-ADVERSARIAL-PASS
+  - MOD-EXECUTION-FIDELITY
+  conflicts: []
+contract:
+  inputs:
+    required_context_fields:
+    - mode
+    - context_mode
+    artifact_classes:
+    - finding_register
+    - adversarial_challenge_set
+    - execution_fidelity_record
+    - fix_verification_records
+  outputs:
+  - id: module_decision
+    required: true
+    description: Decision-bearing module result with gate trace and evidence references.
+  - id: closure_record
+    required: true
+    description: Closure metrics, debt, calibration, behavior flags, human-review tags, stop conditions,
+      and attestation inputs.
+  evidence:
+    required_kinds:
+    - document
+    - test
+    - runtime
+    minimum_sources: 1
