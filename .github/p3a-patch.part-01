+            tool_request=_load_json(root / "schemas" / "tool-request.schema.json"),
+            approval_token=_load_json(root / "schemas" / "approval-token.schema.json"),
+            policy_decision=_load_json(root / "schemas" / "policy-decision.schema.json"),
