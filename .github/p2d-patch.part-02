+schema_version: 1.0.0
+id: MOD-INDEPENDENT-JUDGE
+version: 0.1.0
+status: experimental
+kind: meta
+title: Independent judge reconciliation
+summary: Separates finding assessment from auditor reasoning and reconciles independent verdict, severity,
+  confidence, and divergence.
+gate_coverage:
+- HG-IJ
+phase_coverage:
+- E
+selection:
+  policy: any_active_gate
+  priority: 40
+  dependencies:
+  - MOD-EVIDENCE-ANCHORS
+  conflicts: []
+contract:
+  inputs:
+    required_context_fields:
+    - target_tier
+    - self_audit
+    - async_worker
+    artifact_classes:
+    - finding_register
+    - evidence_matrix
+    - source_records
+  outputs:
+  - id: module_decision
+    required: true
+    description: Decision-bearing module result with gate trace and evidence references.
+  - id: independent_judge_reconciliation
+    required: true
