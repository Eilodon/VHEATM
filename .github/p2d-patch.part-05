@@ -0,0 +1,64 @@
+schema_version: 1.0.0
+id: MOD-UTILITY-TREE
+version: 0.1.0
+status: experimental
+kind: specialist
+title: ATAM utility tree
+summary: Ranks architecture quality attributes and records measurable scenarios, sensitivity points, tradeoffs,
+  and architecture-smell weighting.
+gate_coverage:
+- HG-UT
+phase_coverage:
+- V
+selection:
+  policy: any_active_gate
+  priority: 30
+  dependencies:
+  - MOD-SYSTEM-MAPS
+  conflicts: []
+contract:
+  inputs:
+    required_context_fields:
+    - mode
+    - context_mode
+    artifact_classes:
+    - system_map
+    - architecture_documentation
+    - stakeholder_declarations
+  outputs:
+  - id: module_decision
+    required: true
+    description: Decision-bearing module result with gate trace and evidence references.
+  - id: utility_tree
+    required: true
+    description: Ranked ISO/IEC 25010 quality scenarios with measures, current state, sensitivity points,
+      tradeoffs, and smell weights.
+  evidence:
+    required_kinds:
+    - document
+    - code
+    - configuration
+    minimum_sources: 1
+    freshness_required: true
+  failure:
+    on_missing_input: block
+    on_tool_denied: block
+    produces_unknown: true
+  provenance:
+    claims_required: true
+    sources_required: true
+    legacy_refs:
+    - VHEATM-v16.1.1.skill::references/23-atam-utility-tree.md#When to Run [V.UT]
+    - VHEATM-v16.1.1.skill::references/23-atam-utility-tree.md#[V.UT] 4-Step Mini-Pass
+    - VHEATM-v16.1.1.skill::references/23-atam-utility-tree.md#[V.UT] Output Schema
+  runtime:
+    tool_classes:
+    - read
+    sandbox_required: false
+    network_required: false
+  disclosure:
+    router_summary: Build measurable quality scenarios and feed explicit weighting into architecture-smell
+      review.
+    instruction_path: instructions.md
+    instruction_sha256: 32f1bb0ae0526cc3a990ac87ac7da8e07b5f30d1e38ec99747c362a489141e84
+    token_budget: 80
diff --git a/tests/test_module_router.py b/tests/test_module_router.py
index 14dc596..3be075f 100644
--- a/tests/test_module_router.py
+++ b/tests/test_module_router.py
@@ -29,6 +29,14 @@ EXPECTED_MODULES = {
     "MOD-FIX-VERIFICATION",
     "MOD-ADVERSARIAL-PASS",
     "MOD-EXECUTION-FIDELITY",
+    "MOD-UTILITY-TREE",
+    "MOD-FMEA-LITE",
+    "MOD-INCENTIVE-MISALIGNMENT",
+    "MOD-ORG-BLAST-RADIUS",
+    "MOD-CODE-PATH-TRACE",
+    "MOD-INDEPENDENT-JUDGE",
+    "MOD-CLOSURE-METRICS",
+    "MOD-KNOWLEDGE-BASE",
 }
 
 
@@ -205,3 +213,24 @@ def test_adversarial_pass_depends_on_verified_fixes():
         "MOD-FIX-VERIFICATION",
         "MOD-ADVERSARIAL-PASS",
     ]
+
+
+def test_complete_registry_routes_all_twenty_two_gate_owners():
+    result = load_and_route(ROOT, _plan({gate["id"]: "active" for gate in _manifest()["gates"]["items"]}))
+    ids = [item["id"] for item in result["selected_modules"]]
+    assert len(ids) == 22
+    assert len(set(ids)) == 22
+    assert result["summary"]["budget_exceeded"] is False
+    assert result["summary"]["completion_blocked"] is False
+
+
+def test_triggered_and_meta_completion_dependencies():
+    utility = load_and_route(ROOT, _plan({"HG-UT": "active"}))
+    assert [item["id"] for item in utility["selected_modules"]] == [
+        "MOD-CONTEXT-CONTRACT", "MOD-SYSTEM-MAPS", "MOD-UTILITY-TREE"
+    ]
+    kb = load_and_route(ROOT, _plan({"HG-KB": "active"}))
+    ids = [item["id"] for item in kb["selected_modules"]]
+    assert ids[-2:] == ["MOD-CLOSURE-METRICS", "MOD-KNOWLEDGE-BASE"]
+    assert "MOD-ADVERSARIAL-PASS" in ids
+    assert "MOD-EXECUTION-FIDELITY" in ids
diff --git a/tests/test_registry_integrity.py b/tests/test_registry_integrity.py
index 0fb9780..96f2163 100644
--- a/tests/test_registry_integrity.py
+++ b/tests/test_registry_integrity.py
@@ -59,3 +59,21 @@ def test_registry_root_binds_legacy_source_fingerprint():
     mutated = copy.deepcopy(registry)
     mutated["legacy_source"]["sha256"] = "0" * 64
     assert _registry_root(mutated) != baseline
+
+
+def test_complete_registry_has_one_owner_for_every_manifest_gate():
+    registry = _load_document(ROOT / "modules" / "registry.yaml")
+    manifest = _load_document(ROOT / "manifests" / "vheatm-v17.yaml")
+    assert registry["coverage_mode"] == "complete"
+    issues, modules = validate_module_repository(
+        ROOT, manifest,
+        module_schema=_load_document(ROOT / "schemas" / "module-contract.schema.json"),
+        registry_schema=_load_document(ROOT / "schemas" / "module-registry.schema.json"),
+    )
+    assert issues == []
+    owners = {}
+    for module in modules.values():
+        for gate in module.document["gate_coverage"]:
+            owners.setdefault(gate, []).append(module.id)
+    assert set(owners) == {gate["id"] for gate in manifest["gates"]["items"]}
+    assert all(len(values) == 1 for values in owners.values())
