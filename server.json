{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vheatm/vheatm-control",
  "description": "Machine-validated audit control plane for VHEATM — evaluator, router, and report validator exposed as MCP tools.",
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "vheatm-control",
      "version": "0.4.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "named",
          "name": "--extra",
          "value": "mcp"
        }
      ]
    }
  ]
}
