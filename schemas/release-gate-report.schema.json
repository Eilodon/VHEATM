{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/release-gate-report.schema.json",
  "title": "VHEATM release gate evidence report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "framework_version", "evidence_digest", "evaluated_at", "gates", "summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^RGR-[A-F0-9]{64}$"},
    "framework_version": {"type": "string", "minLength": 1},
    "evidence_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "gates": {
      "type": "array", "minItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["gate_id", "status", "missing_metrics", "failed_metrics", "rationale"],
        "properties": {
          "gate_id": {"type": "string", "pattern": "^RG-[0-9]{2}$"},
          "status": {"enum": ["pass", "fail", "unknown"]},
          "missing_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "failed_metrics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["pass", "fail", "unknown", "ga_eligible"],
      "properties": {"pass": {"type": "integer", "minimum": 0}, "fail": {"type": "integer", "minimum": 0}, "unknown": {"type": "integer", "minimum": 0}, "ga_eligible": {"type": "boolean"}}
    }
  }
}
