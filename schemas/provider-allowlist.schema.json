{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/provider-allowlist.schema.json",
  "title": "VHEATM brokered provider allowlist policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "framework_version", "providers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^vheatm-[a-z0-9-]+$"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "framework_version": {"type": "string", "minLength": 1},
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["provider_id", "provider_versions", "qualification_state"],
        "properties": {
          "provider_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
          "provider_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "qualification_state": {"enum": ["pending", "qualified", "revoked"]}
        }
      }
    }
  }
}
