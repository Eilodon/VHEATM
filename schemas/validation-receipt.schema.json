{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/validation-receipt.schema.json",
  "title": "VHEATM explicit validation receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source_refs", "validator", "method", "result", "validated_at"],
  "properties": {
    "id": {"type": "string", "pattern": "^VRF-[A-F0-9]{64}$"},
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[A-F0-9]{64}$"}
    },
    "validator": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "result": {"enum": ["validated", "rejected"]},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "validated_at": {"type": "string", "format": "date-time"}
  }
}
