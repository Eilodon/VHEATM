{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/ai-rmf-overlay.schema.json",
  "title": "VHEATM NIST AI RMF overlay record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_id", "status", "evidence_state", "authority_eligible", "model", "ai_inputs", "ai_outputs", "human_oversight_points", "monitoring_coverage", "standards_binding", "functions", "missing_requirements", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^AIR-[A-F0-9]{64}$"},
    "status": {"enum": ["complete", "unknown", "not_applicable"]},
    "evidence_state": {"enum": ["candidate", "unknown", "not_applicable"]},
    "authority_eligible": {"const": false},
    "model": {"type": ["object", "null"], "additionalProperties": false, "required": ["provider_id", "model_id", "config_digest"], "properties": {
      "provider_id": {"type": ["string", "null"], "minLength": 1},
      "model_id": {"type": ["string", "null"], "minLength": 1},
      "config_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
    }},
    "ai_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "ai_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "human_oversight_points": {"type": "integer", "minimum": 0},
    "monitoring_coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "standards_binding": {"type": ["object", "null"], "additionalProperties": false, "required": ["id", "version", "namespace", "status", "policy_digest", "scope"], "properties": {
      "id": {"const": "NIST-AI-RMF-1.0"},
      "version": {"type": "string", "minLength": 1},
      "namespace": {"const": "normative"},
      "status": {"const": "pinned"},
      "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "scope": {"type": "string", "minLength": 1}
    }},
    "functions": {"type": "object", "additionalProperties": false, "required": ["govern", "map", "measure", "manage"], "properties": {"govern": {"type": "boolean"}, "map": {"type": "boolean"}, "measure": {"type": "boolean"}, "manage": {"type": "boolean"}}},
    "missing_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
