{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/qualification-evidence.schema.json",
  "title": "VHEATM independently qualified measurement evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "evidence_id", "manifest_id", "manifest_digest", "evaluator_id", "evaluator_version", "independent_judge_id", "measurements", "metrics", "evidence_state", "signature_algorithm", "signature_key_id", "signature_value", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "evidence_id": {"type": "string", "pattern": "^QEV-[A-F0-9]{64}$"},
    "manifest_id": {"type": "string", "pattern": "^QMF-[A-F0-9]{64}$"},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_id": {"type": "string", "minLength": 1},
    "evaluator_version": {"type": "string", "minLength": 1},
    "independent_judge_id": {"type": "string", "minLength": 1},
    "measurements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["metric", "value", "sample_count", "confidence_lower", "method_digest", "evidence_refs"], "properties": {"metric": {"type": "string", "minLength": 1}, "value": {"type": ["number", "boolean"]}, "sample_count": {"type": "integer", "minimum": 1}, "confidence_lower": {"type": "number", "minimum": 0}, "method_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}},
    "metrics": {"type": "object", "minProperties": 1, "additionalProperties": {"type": ["number", "boolean"]}},
    "evidence_state": {"enum": ["verified", "unverified", "unknown"]},
    "signature_algorithm": {"type": ["string", "null"], "enum": ["ed25519", null]},
    "signature_key_id": {"type": ["string", "null"], "minLength": 1},
    "signature_value": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+={0,2}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
