{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/session-event.schema.json",
  "title": "VHEATM append-only session journal event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "session_id",
    "sequence",
    "event_type",
    "actor",
    "occurred_at",
    "idempotency_key",
    "from_state",
    "to_state",
    "data",
    "prev_hash",
    "event_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type": "string", "pattern": "^EVT-[A-F0-9]{64}$"},
    "session_id": {"type": "string", "pattern": "^SES-[A-F0-9]{64}$"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,63}$"},
    "actor": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "from_state": {"enum": ["created", "context_validated", "planned", "running", "blocked", "partial", "complete", "attested"]},
    "to_state": {"enum": ["created", "context_validated", "planned", "running", "blocked", "partial", "complete", "attested"]},
    "data": {"type": "object"},
    "prev_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "event_hash": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
  }
}
