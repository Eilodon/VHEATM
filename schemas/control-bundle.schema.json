{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/control-bundle.schema.json",
  "title": "VHEATM canonical control bundle inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_root", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
