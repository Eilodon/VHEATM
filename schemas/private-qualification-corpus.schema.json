{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/private-qualification-corpus.schema.json",
  "title": "VHEATM private qualification corpus envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus_id", "framework_version", "visibility", "time_slice", "cases", "corpus_digest"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_id": {"type": "string", "pattern": "^PQC-[A-F0-9]{64}$"},
    "framework_version": {"type": "string", "minLength": 1},
    "visibility": {"const": "private"},
    "time_slice": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "cases": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "captured_at", "case_digest", "payload"], "properties": {"case_id": {"type": "string", "pattern": "^PQC-[A-Z0-9-]+$"}, "captured_at": {"type": "string", "format": "date-time"}, "case_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "payload": {"type": "object"}}}},
    "corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
