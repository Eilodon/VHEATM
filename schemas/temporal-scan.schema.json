{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/temporal-scan.schema.json",
  "title": "VHEATM temporal and L4 scan record",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_id", "mode", "status", "evidence_state", "authority_eligible", "snapshots", "sublayers", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^TSC-[A-F0-9]{64}$"},
    "mode": {"enum": ["fast", "standard", "full"]},
    "status": {"enum": ["complete", "unknown", "blocked"]},
    "evidence_state": {"enum": ["candidate", "unknown"]},
    "authority_eligible": {"const": false},
    "snapshots": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshot_id", "captured_at", "digest"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "captured_at": {"type": "string", "format": "date-time"},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }},
    "sublayers": {"type": "array", "minItems": 6, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^L4\\.[1-6]$"},
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
      }
    }},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
