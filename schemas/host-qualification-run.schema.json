{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/host-qualification-run.schema.json",
  "title": "VHEATM host sandbox qualification run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "framework_version", "bundle_root", "runner_id", "runner_version", "backend", "backend_digest", "host_identity_digest", "reference_monitor_status", "status", "evidence_state", "observations", "measurements", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^HQR-[A-F0-9]{64}$"},
    "framework_version": {"type": "string", "minLength": 1},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runner_id": {"type": "string", "minLength": 1},
    "runner_version": {"type": "string", "minLength": 1},
    "backend": {"const": "bubblewrap"},
    "backend_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "host_identity_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference_monitor_status": {"enum": ["observed", "unavailable", "partial", "failed"]},
    "status": {"enum": ["complete", "partial", "blocked"]},
    "evidence_state": {"const": "unverified"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observation_id", "sample_index", "kind", "status", "elapsed_seconds", "sandbox_run_id", "controls", "details"],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^HOB-[A-F0-9]{64}$"},
          "sample_index": {"type": "integer", "minimum": 1},
          "kind": {"const": "hard_stop_timeout"},
          "status": {"enum": ["observed", "unavailable", "failed"]},
          "elapsed_seconds": {"type": "number", "minimum": 0},
          "sandbox_run_id": {"type": ["string", "null"], "pattern": "^SBR-[A-F0-9]{64}$"},
          "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "details": {"type": "object", "additionalProperties": false, "required": ["reason"], "properties": {"reason": {"type": "string", "minLength": 1}, "sandbox_status": {"type": ["string", "null"]}, "exit_code": {"type": ["integer", "null"]}, "stderr_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "timeout_budget_seconds": {"type": "number", "exclusiveMinimum": 0}}}
        }
      }
    },
    "measurements": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "value", "sample_count", "confidence_lower", "method_digest", "evidence_refs"],
        "properties": {
          "metric": {"const": "hard_stop_p99_seconds"},
          "value": {"type": "number", "minimum": 0},
          "sample_count": {"type": "integer", "minimum": 1},
          "confidence_lower": {"type": "number", "minimum": 0},
          "method_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^HOB-[A-F0-9]{64}$"}}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
