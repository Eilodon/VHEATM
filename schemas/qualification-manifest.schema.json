{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/qualification-manifest.schema.json",
  "title": "VHEATM private time-sliced qualification manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "framework_version", "visibility", "private_locator", "time_slice", "case_count", "case_digests", "corpus_digest", "verification_state", "signature_algorithm", "signature_key_id", "signature_value", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^QMF-[A-F0-9]{64}$"},
    "framework_version": {"type": "string", "minLength": 1},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visibility": {"const": "private"},
    "private_locator": {"type": "string", "minLength": 1},
    "time_slice": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}},
    "case_count": {"type": "integer", "minimum": 1},
    "case_digests": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "corpus_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verification_state": {"enum": ["verified", "unverified", "unknown"]},
    "signature_algorithm": {"type": ["string", "null"], "enum": ["ed25519", null]},
    "signature_key_id": {"type": ["string", "null"], "minLength": 1},
    "signature_value": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+={0,2}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
