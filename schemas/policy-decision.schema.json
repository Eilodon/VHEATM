{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/policy-decision.schema.json",
  "title": "VHEATM policy decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "decision", "reason", "controls", "evaluated_at", "approval_token_id"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["allow", "deny"]},
    "reason": {"type": "string", "minLength": 1},
    "controls": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "approval_token_id": {
      "oneOf": [
        {"type": "string", "pattern": "^APR-[A-F0-9]{64}$"},
        {"type": "null"}
      ]
    }
  }
}
