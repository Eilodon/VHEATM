{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/audit-report.schema.json",
  "title": "VHEATM audit report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework_version",
    "mode",
    "target_tier",
    "cycle_status",
    "declarations",
    "gate_results",
    "findings",
    "attestation"
  ],
  "properties": {
    "framework_version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["fast", "standard", "full"]},
    "target_tier": {"enum": [1, 2, 3]},
    "cycle_status": {"enum": ["complete", "blocked", "partial"]},
    "lifecycle_state": {"enum": ["created", "context_validated", "planned", "running", "blocked", "partial", "complete", "attested"]},
    "lifecycle": {"$ref": "https://vheatm.dev/schemas/audit-lifecycle.schema.json"},
    "declarations": {"type": "object", "additionalProperties": {"enum": ["yes", "no", "unknown"]}},
    "activation_plan": {"$ref": "https://vheatm.dev/schemas/gate-plan.schema.json"},
    "provenance": {"$ref": "https://vheatm.dev/schemas/provenance-registry.schema.json"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id", "selection_digest", "module_selection", "module_runs", "module_runs_digest",
        "artifacts", "artifacts_digest", "validation_receipts", "validation_receipts_digest"
      ],
      "properties": {
        "plan_id": {"type": "string", "pattern": "^PLN-[a-f0-9]{64}$"},
        "selection_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "module_selection": {"$ref": "https://vheatm.dev/schemas/module-selection.schema.json"},
        "module_runs": {"type": "array", "items": {"$ref": "https://vheatm.dev/schemas/module-run.schema.json"}},
        "module_runs_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "artifacts": {"type": "array", "items": {"$ref": "https://vheatm.dev/schemas/artifact-envelope.schema.json"}},
        "artifacts_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "validation_receipts": {"type": "array", "items": {"$ref": "https://vheatm.dev/schemas/validation-receipt.schema.json"}},
        "validation_receipts_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "gate_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gate", "state", "reason"],
        "properties": {
          "gate": {"type": "string", "pattern": "^HG-[A-Z]+$"},
          "state": {"enum": ["pass", "fail", "unknown", "not_applicable"]},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(?:SRC|CLM|VRF|ART)-[A-F0-9]{64}$"}
          }
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "https://vheatm.dev/schemas/finding.schema.json"}},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executor", "validated_at", "limitations"],
      "properties": {
        "executor": {"type": "string", "minLength": 1},
        "validated_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "limitations": {"type": "array", "items": {"type": "string"}},
        "subject_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
