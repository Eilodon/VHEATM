{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/cross-cutting-scan.schema.json",
  "title": "VHEATM cross-cutting L7 scan plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "record_id", "context_digest", "status", "evidence_state", "authority_eligible", "obligations", "missing_requirements", "diagnostics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_id": {"type": "string", "pattern": "^CTC-[A-F0-9]{64}$"},
    "context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["complete", "unknown"]},
    "evidence_state": {"enum": ["candidate", "unknown"]},
    "authority_eligible": {"const": false},
    "obligations": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "required", "owner"],
      "properties": {
        "id": {"type": "string", "pattern": "^L7\\.(?:[1-9]|1[01])$"},
        "required": {"type": "boolean"},
        "owner": {"type": "string", "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
      }
    }},
    "missing_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
