{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/provenance-statement.schema.json",
  "title": "VHEATM signed build provenance statement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "statement_id", "bundle_root", "sbom_digest", "builder_id", "build_type", "verified", "signature_algorithm", "signature_key_id", "signature_value", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "statement_id": {"type": "string", "pattern": "^PROV-[A-F0-9]{64}$"},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sbom_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "builder_id": {"type": "string", "minLength": 1},
    "build_type": {"type": "string", "minLength": 1},
    "verified": {"type": "boolean"},
    "signature_algorithm": {"type": ["string", "null"], "enum": ["ed25519", null]},
    "signature_key_id": {"type": ["string", "null"], "minLength": 1},
    "signature_value": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+={0,2}$"},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
