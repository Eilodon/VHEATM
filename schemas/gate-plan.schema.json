{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/gate-plan.schema.json",
  "title": "VHEATM gate activation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_version",
    "manifest_digest",
    "bundle_root",
    "context_digest",
    "evaluator_build",
    "evaluator_digest",
    "plan_revision",
    "plan_digest",
    "plan_id",
    "session_root",
    "context",
    "summary",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "framework_version": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evaluator_build": {"type": "string", "minLength": 1},
    "evaluator_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_revision": {"type": "integer", "minimum": 0},
    "parent_plan_id": {"type": ["string", "null"], "pattern": "^PLN-[a-f0-9]{64}$"},
    "revision_reason": {"type": "string", "minLength": 1},
    "plan_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_id": {"type": "string", "pattern": "^PLN-[a-f0-9]{64}$"},
    "session_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "context": {"$ref": "https://vheatm.dev/schemas/audit-context.schema.json"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "inactive", "unknown", "total", "completion_blocked"],
      "properties": {
        "active": {"type": "integer", "minimum": 0},
        "inactive": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1},
        "completion_blocked": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "phase", "activation", "activation_state", "unknown_references", "reason"],
        "properties": {
          "id": {"type": "string", "pattern": "^HG-[A-Z]+$"},
          "layer": {"enum": ["core", "triggered", "meta"]},
          "phase": {"enum": ["P", "V", "G", "E", "A", "T", "M", "KB"]},
          "activation": {"type": "string", "minLength": 1},
          "activation_state": {"enum": ["active", "inactive", "unknown"]},
          "unknown_references": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          },
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
