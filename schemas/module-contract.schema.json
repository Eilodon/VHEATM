{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/module-contract.schema.json",
  "title": "VHEATM executable instruction module contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "version", "status", "kind", "title", "summary",
    "gate_coverage", "phase_coverage", "selection", "contract"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "status": {"enum": ["experimental", "stable", "deprecated"]},
    "kind": {"enum": ["core", "specialist", "meta"]},
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "summary": {"type": "string", "minLength": 10, "maxLength": 320},
    "gate_coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^HG-[A-Z0-9]+$"}
    },
    "phase_coverage": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["P", "V", "G", "E", "A", "T", "M", "KB"]}
    },
    "selection": {
      "type": "object", "additionalProperties": false,
      "required": ["policy", "priority", "dependencies", "conflicts"],
      "properties": {
        "policy": {"enum": ["any_active_gate", "all_active_gates"]},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "dependencies": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        },
        "conflicts": {
          "type": "array", "uniqueItems": true,
          "items": {"type": "string", "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"}
        }
      }
    },
    "contract": {
      "type": "object", "additionalProperties": false,
      "required": ["inputs", "outputs", "evidence", "failure", "provenance", "runtime", "disclosure"],
      "properties": {
        "inputs": {
          "type": "object", "additionalProperties": false,
          "required": ["required_context_fields", "artifact_classes"],
          "properties": {
            "required_context_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
            "artifact_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
          }
        },
        "outputs": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "required", "description"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
              "required": {"type": "boolean"},
              "description": {"type": "string", "minLength": 5}
            }
          }
        },
        "evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["required_kinds", "minimum_sources", "freshness_required"],
          "properties": {
            "required_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
            "minimum_sources": {"type": "integer", "minimum": 0},
            "freshness_required": {"type": "boolean"}
          }
        },
        "failure": {
          "type": "object", "additionalProperties": false,
          "required": ["on_missing_input", "on_tool_denied", "produces_unknown"],
          "properties": {
            "on_missing_input": {"enum": ["block", "defer", "skip"]},
            "on_tool_denied": {"enum": ["block", "manual", "skip"]},
            "produces_unknown": {"type": "boolean"}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "required": ["claims_required", "sources_required", "legacy_refs"],
          "properties": {
            "claims_required": {"type": "boolean"},
            "sources_required": {"type": "boolean"},
            "legacy_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9._-]+\\.skill::(?:SKILL\\.md|references/[A-Za-z0-9._/-]+\\.md)#[^\\r\\n]+$"}}
          }
        },
        "runtime": {
          "type": "object", "additionalProperties": false,
          "required": ["tool_classes", "sandbox_required", "network_required"],
          "properties": {
            "tool_classes": {
              "type": "array", "uniqueItems": true,
              "items": {"enum": ["read", "execute", "write", "network", "secrets"]}
            },
            "sandbox_required": {"type": "boolean"},
            "network_required": {"type": "boolean"}
          }
        },
        "disclosure": {
          "type": "object", "additionalProperties": false,
          "required": ["router_summary", "instruction_path", "instruction_sha256", "token_budget"],
          "properties": {
            "router_summary": {"type": "string", "minLength": 10, "maxLength": 280},
            "instruction_path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
            "instruction_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "token_budget": {"type": "integer", "minimum": 64, "maximum": 16000}
          }
        }
      }
    }
  }
}
