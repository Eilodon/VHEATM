{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/module-registry.schema.json",
  "title": "VHEATM module registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework_version",
    "legacy_source",
    "gate_owner_coverage",
    "hard_token_budget",
    "required_gate_coverage",
    "modules"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "framework_version": {
      "type": "string",
      "minLength": 1
    },
    "gate_owner_coverage": {
      "enum": [
        "pilot",
        "complete"
      ]
    },
    "hard_token_budget": {
      "type": "integer",
      "minimum": 256,
      "maximum": 100000
    },
    "required_gate_coverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^HG-[A-Z0-9]+$"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^MOD-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          },
          "path": {
            "type": "string",
            "pattern": "^modules/[A-Za-z0-9._/-]+\\.ya?ml$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "legacy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "version",
        "archive_status",
        "source_basis",
        "archive_path",
        "corpus_root",
        "corpus_digest",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.skill$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "archive_status": {
          "enum": [
            "verified",
            "unavailable"
          ]
        },
        "source_basis": {
          "enum": [
            "original_archive",
            "extracted_corpus"
          ]
        },
        "archive_path": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "corpus_root": {
          "type": "string",
          "minLength": 1
        },
        "corpus_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    }
  },
  "allOf": [
      {
        "if": {
          "properties": {
            "archive_status": {
              "const": "verified"
            }
          },
          "required": [
            "archive_status"
          ]
        },
        "then": {
          "properties": {
            "source_basis": {
              "const": "original_archive"
            },
            "archive_path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "size_bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "archive_status": {
              "const": "unavailable"
            }
          },
          "required": [
            "archive_status"
          ]
        },
        "then": {
          "properties": {
            "source_basis": {
              "const": "extracted_corpus"
            },
            "archive_path": {
              "const": null
            },
            "sha256": {
              "const": null
            },
            "size_bytes": {
              "const": null
            }
          }
        }
      }
    ]
}
