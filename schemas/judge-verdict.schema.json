{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/judge-verdict.schema.json",
  "title": "VHEATM independent-judge verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verdict_id", "packet_id", "request_id", "judge_provider_id", "judge_model_id", "config_digest", "order_digest", "status", "epistemic_status", "decisions", "generated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "verdict_id": {"type": "string", "pattern": "^JVR-[A-F0-9]{64}$"},
    "packet_id": {"type": "string", "pattern": "^JPK-[A-F0-9]{64}$"},
    "request_id": {"type": "string", "pattern": "^JDR-[A-F0-9]{64}$"},
    "judge_provider_id": {"type": "string", "minLength": 1},
    "judge_model_id": {"type": "string", "minLength": 1},
    "framework_version": {"type": "string", "minLength": 1},
    "bundle_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "config_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "order_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["complete", "blocked", "unknown"]},
    "epistemic_status": {"enum": ["independent_candidate", "unknown"]},
    "decisions": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["item_id", "label", "confidence"],
        "properties": {"item_id": {"type": "string", "minLength": 1}, "label": {"enum": ["yes", "no", "unknown"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "signature_algorithm": {"type": ["string", "null"], "enum": ["ed25519", null]},
    "signature_key_id": {"type": ["string", "null"], "minLength": 1},
    "signature_value": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9_-]+={0,2}$"}
  }
}
