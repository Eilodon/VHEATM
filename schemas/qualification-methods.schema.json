{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/qualification-methods.schema.json",
  "title": "VHEATM canonical qualification measurement methods",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "policy_version", "framework_version", "required_metrics", "methods"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "framework_version": {"type": "string", "minLength": 1},
    "required_metrics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric", "sample_basis", "estimator", "confidence_method", "minimum_sample_count"],
        "properties": {
          "metric": {"type": "string", "minLength": 1},
          "sample_basis": {"enum": ["private_case_trials", "repeated_evaluation", "private_corpus_observation"]},
          "estimator": {"type": "string", "minLength": 1},
          "confidence_method": {"enum": ["wilson_lower_95", "wilson_upper_95", "descriptive_observation", "exact_count", "empirical_margin", "percentile_99", "brier_delta", "boolean_assertion", "trace_ratio"]},
          "minimum_sample_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
