{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/finding.schema.json",
  "title": "VHEATM finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "severity", "priority", "epistemic_status", "confidence", "evidence", "ownership", "remediation", "gate_trace"],
  "properties": {
    "id": {"type": "string", "pattern": "^F-[A-Z0-9-]+$"},
    "title": {"type": "string", "minLength": 5},
    "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
    "priority": {"enum": ["mandatory", "required", "recommended", "optional"]},
    "epistemic_status": {"enum": ["verified", "inferred", "unknown", "contradicted"]},
    "confidence": {"oneOf": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "null"}]},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "anchor", "claim"], "properties": {"kind": {"enum": ["code", "test", "runtime", "document", "external", "human"]}, "anchor": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "verified": {"type": "boolean", "default": false}}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["owner", "boundary"], "properties": {"owner": {"type": "string", "minLength": 1}, "boundary": {"enum": ["none", "technical", "handoff", "approval", "disputed", "unknown"]}}},
    "remediation": {"type": "object", "additionalProperties": false, "required": ["action", "verification", "rollback"], "properties": {"action": {"type": "string", "minLength": 1}, "verification": {"type": "string", "minLength": 1}, "rollback": {"type": "string", "minLength": 1}}},
    "gate_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^HG-[A-Z]+$"}}
  },
  "allOf": [
    {"if": {"properties": {"epistemic_status": {"const": "unknown"}}, "required": ["epistemic_status"]}, "then": {"properties": {"confidence": {"type": "null"}}}},
    {"if": {"properties": {"priority": {"const": "mandatory"}}, "required": ["priority"]}, "then": {"properties": {"evidence": {"minItems": 1}, "ownership": {"properties": {"owner": {"not": {"const": "unknown"}}}}}}}
  ]
}
