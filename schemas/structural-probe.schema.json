{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/structural-probe.schema.json",
  "title": "VHEATM read-only Python structural probe bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "probe_type", "workspace", "requested_paths", "status", "generated_at", "limits", "summary", "files", "errors", "root_hash"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "probe_id": {"type": "string", "pattern": "^PRB-[A-F0-9]{16}$"},
    "probe_type": {"const": "python_ast_v1"},
    "workspace": {"const": "workspace:"},
    "requested_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["complete", "blocked"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_files", "max_bytes_per_file", "max_ast_nodes"],
      "properties": {
        "max_files": {"type": "integer", "minimum": 1},
        "max_bytes_per_file": {"type": "integer", "minimum": 1},
        "max_ast_nodes": {"type": "integer", "minimum": 1}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovered_files", "parsed_files", "symbols", "imports", "calls", "errors"],
      "properties": {
        "discovered_files": {"type": "integer", "minimum": 0},
        "parsed_files": {"type": "integer", "minimum": 0},
        "symbols": {"type": "integer", "minimum": 0},
        "imports": {"type": "integer", "minimum": 0},
        "calls": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "language", "source", "ast_digest", "ast_nodes", "symbols", "imports", "calls"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "language": {"const": "python"},
          "source": {"$ref": "https://vheatm.dev/schemas/provenance-record.schema.json"},
          "ast_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "ast_nodes": {"type": "integer", "minimum": 1},
          "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
          "imports": {"type": "array", "items": {"$ref": "#/$defs/import"}},
          "calls": {"type": "array", "items": {"$ref": "#/$defs/call"}}
        }
      }
    },
    "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}},
    "root_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "location": {
      "type": "object",
      "properties": {
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 0},
        "end_line": {"type": "integer", "minimum": 1},
        "end_column": {"type": "integer", "minimum": 0}
      },
      "required": ["line", "column", "end_line", "end_column"]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "annotation", "has_default"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["positional_only", "positional", "var_positional", "keyword_only", "var_keyword"]},
        "annotation": {"type": ["string", "null"]},
        "has_default": {"type": "boolean"}
      }
    },
    "symbol": {
      "allOf": [
        {"$ref": "#/$defs/location"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "qualified_name", "decorators", "line", "column", "end_line", "end_column"],
          "properties": {
            "kind": {"enum": ["class", "function", "async_function", "method", "async_method"]},
            "name": {"type": "string", "minLength": 1},
            "qualified_name": {"type": "string", "minLength": 1},
            "decorators": {"type": "array", "items": {"type": "string"}},
            "bases": {"type": "array", "items": {"type": "string"}},
            "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
            "returns": {"type": ["string", "null"]},
            "line": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 0},
            "end_line": {"type": "integer", "minimum": 1},
            "end_column": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "import": {
      "allOf": [
        {"$ref": "#/$defs/location"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "module", "name", "alias", "level", "line", "column", "end_line", "end_column"],
          "properties": {
            "kind": {"enum": ["import", "from"]},
            "module": {"type": ["string", "null"]},
            "name": {"type": ["string", "null"]},
            "alias": {"type": ["string", "null"]},
            "level": {"type": "integer", "minimum": 0},
            "line": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 0},
            "end_line": {"type": "integer", "minimum": 1},
            "end_column": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "call": {
      "allOf": [
        {"$ref": "#/$defs/location"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["callee", "dynamic", "caller", "positional_arguments", "keyword_arguments", "has_star_arguments", "has_star_keywords", "line", "column", "end_line", "end_column"],
          "properties": {
            "callee": {"type": ["string", "null"]},
            "dynamic": {"type": "boolean"},
            "caller": {"type": "string", "minLength": 1},
            "positional_arguments": {"type": "integer", "minimum": 0},
            "keyword_arguments": {"type": "integer", "minimum": 0},
            "has_star_arguments": {"type": "boolean"},
            "has_star_keywords": {"type": "boolean"},
            "line": {"type": "integer", "minimum": 1},
            "column": {"type": "integer", "minimum": 0},
            "end_line": {"type": "integer", "minimum": 1},
            "end_column": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "code", "message"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "code": {"enum": ["not_found", "no_python_files", "unsupported_extension", "unsupported_path", "symlink_rejected", "limit_exceeded", "syntax_error", "probe_error"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
