{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/tool-request.schema.json",
  "title": "VHEATM guarded tool request",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "requester", "tool_class", "scope"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "request_id": {"type": "string", "minLength": 1},
    "requester": {"type": "string", "minLength": 1},
    "tool_class": {"enum": ["read", "execute", "write", "network", "secrets"]},
    "scope": {"type": "string", "pattern": "^workspace:"},
    "secret_expansion": {"type": "boolean"},
    "contains_secrets": {"type": "boolean"},
    "sandboxed": {"type": "boolean"},
    "command": {"type": "string", "minLength": 1},
    "network_enabled": {"type": "boolean"},
    "inherit_secrets": {"type": "boolean"},
    "diff_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollback_plan": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "data_classes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "redacted": {"type": "boolean"},
    "secret_name": {"type": "string", "minLength": 1},
    "least_privilege": {"type": "boolean"},
    "no_model_echo": {"type": "boolean"}
  },
  "allOf": [
    {"if": {"properties": {"tool_class": {"const": "execute"}}, "required": ["tool_class"]}, "then": {"required": ["sandboxed", "command", "network_enabled", "inherit_secrets"]}},
    {"if": {"properties": {"tool_class": {"const": "write"}}, "required": ["tool_class"]}, "then": {"required": ["diff_paths", "rollback_plan"]}},
    {"if": {"properties": {"tool_class": {"const": "network"}}, "required": ["tool_class"]}, "then": {"required": ["destination", "data_classes", "redacted"]}},
    {"if": {"properties": {"tool_class": {"const": "secrets"}}, "required": ["tool_class"]}, "then": {"required": ["secret_name", "least_privilege", "no_model_echo"]}}
  ]
}
