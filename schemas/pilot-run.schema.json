{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vheatm.dev/schemas/pilot-run.schema.json",
  "title": "VHEATM shadow or canary pilot record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pilot_id", "session_root", "plan_id", "release_report_id", "profile", "read_only", "tools_enabled", "status", "rollback_plan", "drills", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "pilot_id": {"type": "string", "pattern": "^PIL-[A-F0-9]{64}$"},
    "session_root": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "plan_id": {"type": "string", "pattern": "^PLN-[a-f0-9]{64}$"},
    "release_report_id": {"type": "string", "pattern": "^RGR-[A-F0-9]{64}$"},
    "profile": {"enum": ["shadow", "canary"]},
    "read_only": {"type": "boolean"},
    "tools_enabled": {"type": "boolean"},
    "status": {"enum": ["ready", "blocked", "complete", "rollback"]},
    "rollback_plan": {"type": "string", "minLength": 1},
    "drills": {
      "type": "array", "minItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["drill_id", "status", "evidence_refs"],
        "properties": {"drill_id": {"enum": ["incident", "rollback", "evidence_store_outage", "clock_skew", "provider_outage"]}, "status": {"enum": ["pass", "fail", "unknown"]}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "observations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["observation_id", "status", "provider_id", "provider_run_refs", "sample_count", "read_only_confirmed", "evidence_refs", "observed_at"], "properties": {"observation_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail", "unknown"]}, "provider_id": {"type": "string", "minLength": 1}, "provider_run_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^PRV-[A-F0-9]{64}$"}}, "sample_count": {"type": "integer", "minimum": 1}, "read_only_confirmed": {"type": "boolean"}, "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "observed_at": {"type": "string", "format": "date-time"}}}},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "rollback_reason": {"type": "string", "minLength": 1},
    "rollback_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "shadow"}}, "required": ["profile"]},
      "then": {"properties": {"read_only": {"const": true}, "tools_enabled": {"const": false}}}
    },
    {
      "if": {"properties": {"profile": {"const": "canary"}}, "required": ["profile"]},
      "then": {"properties": {"read_only": {"const": false}, "tools_enabled": {"const": true}}}
    },
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "required": ["observations", "completed_at"],
        "properties": {"observations": {"type": "array", "minItems": 1}}
      }
    },
    {
      "if": {"properties": {"status": {"const": "rollback"}}, "required": ["status"]},
      "then": {"required": ["rollback_reason", "rollback_at"]}
    }
  ]
}
